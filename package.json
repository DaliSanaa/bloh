{
  "name": "bloh",
  "version": "1.0.0",
  "description": "Stateless document extraction API",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=.env dist/server.js",
    "dev": "tsc --watch & node --watch --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/fastify": "3.1.31",
    "@fastify/cookie": "11.0.2",
    "@fastify/formbody": "8.0.2",
    "@fastify/multipart": "10.0.0",
    "@fastify/static": "9.1.3",
    "@llamaindex/liteparse": "2.0.0",
    "better-sqlite3": "12.10.0",
    "fastify": "5.8.5",
    "stripe": "22.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "25.9.1",
    "typescript": "6.0.3"
  }
}
